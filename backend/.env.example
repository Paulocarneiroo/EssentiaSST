# ─── Servidor ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Interface onde a API escuta:
#   0.0.0.0   = todas as interfaces — acessível pela LAN (padrão)
#   127.0.0.1 = apenas a própria máquina
HOST=0.0.0.0

# ─── Banco de dados (Prisma Postgres local — sem Docker) ──────────────────
# Subir:  npx prisma dev --name essentiasst --detach
# Listar: npx prisma dev ls
# Parar:  npx prisma dev stop essentiasst
#
# As URLs abaixo batem com as portas padrão do `prisma dev`.
# Se usar outras portas, copie as URLs impressas por `npx prisma dev ls`.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&connection_limit=10&connect_timeout=0&max_idle_connection_lifetime=0&pool_timeout=0&socket_timeout=0"
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable&connection_limit=10&connect_timeout=0&max_idle_connection_lifetime=0&pool_timeout=0&socket_timeout=0"

# Alternativa com Docker Compose (backend/docker-compose.yml):
# DATABASE_URL="postgresql://essentiasst:changeme@localhost:5432/essentiasst?schema=public"
# SHADOW_DATABASE_URL=   # com Postgres real o Prisma cria o shadow DB sozinho;
#                        # se o schema exigir a var, use outra database no mesmo servidor.

# ─── Autenticação ─────────────────────────────────────────────────────────
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=1d

# ─── Mensageria eSocial ───────────────────────────────────────────────────
# Destino do envio (campo tpAmb do leiaute):
#   PRODUCAO_RESTRITA = homologação/sandbox (padrão, não gera obrigação real)
#   PRODUCAO          = ambiente oficial
ESOCIAL_AMBIENTE=PRODUCAO_RESTRITA

# Implementação de IClienteESocial:
#   sandbox = simulador local, sem rede nem certificado
#   govbr   = webservice oficial (ainda não implementado — exige ICP-Brasil)
ESOCIAL_CLIENTE=sandbox

# Proporção de rejeições simuladas pelo sandbox (0 a 1), para exercitar o reenvio.
ESOCIAL_TAXA_REJEICAO=0
