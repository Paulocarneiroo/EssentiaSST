# ─── Servidor ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Interface onde a API escuta:
#   0.0.0.0   = todas as interfaces — acessível pela LAN (padrão)
#   127.0.0.1 = apenas a própria máquina
HOST=0.0.0.0

# ─── Banco de dados (PostgreSQL) ──────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=essentiasst
DB_USER=essentiasst
DB_PASSWORD=changeme

# String de conexão usada pelo Prisma (deve refletir as variáveis DB_* acima)
DATABASE_URL="postgresql://essentiasst:changeme@localhost:5432/essentiasst?schema=public"

# ─── Autenticação ─────────────────────────────────────────────────────────
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=1d

# ─── Mensageria eSocial ───────────────────────────────────────────────────
# Destino do envio (campo tpAmb do leiaute):
#   PRODUCAO_RESTRITA = homologação/sandbox (padrão, não gera obrigação real)
#   PRODUCAO          = ambiente oficial
ESOCIAL_AMBIENTE=PRODUCAO_RESTRITA

# Implementação de IClienteESocial:
#   sandbox = simulador local, sem rede nem certificado
#   govbr   = webservice oficial (ainda não implementado — exige ICP-Brasil)
ESOCIAL_CLIENTE=sandbox

# Proporção de rejeições simuladas pelo sandbox (0 a 1), para exercitar o reenvio.
ESOCIAL_TAXA_REJEICAO=0
