// EssentiaSST — schema Prisma
// Módulo 1: Cadastro de Empresas e Colaboradores.
// Modelos mapeados para as tabelas/colunas snake_case do PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  // Usado pelo `prisma migrate` com Prisma Postgres local (`prisma dev`)
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

/// Empresa é o tenant (cliente contratante) — raiz do agregado.
model Empresa {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cnpj         String    @unique @db.VarChar(14)
  razaoSocial  String    @map("razao_social") @db.VarChar(255)
  nomeFantasia String    @map("nome_fantasia") @db.VarChar(255)
  cnae         String    @db.VarChar(10)
  grauRisco    Int       @map("grau_risco")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  colaboradores Colaborador[]
  usuarios      Usuario[]
  riscos        Risco[]
  eventos       EventoESocial[]

  @@map("empresas")
}

/// Papel do usuário dentro do tenant (empresa).
enum PapelUsuario {
  ADMIN
  OPERADOR

  @@map("papel_usuario")
}

/// Usuário que autentica na plataforma; pertence a uma Empresa (tenant).
model Usuario {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId String       @map("empresa_id") @db.Uuid
  nome      String       @db.VarChar(255)
  email     String       @unique @db.VarChar(255)
  senhaHash String       @map("senha_hash") @db.VarChar(255)
  papel     PapelUsuario @default(OPERADOR)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@map("usuarios")
}

/// Colaborador vinculado a uma Empresa (composição: existe apenas dentro dela).
model Colaborador {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId      String    @map("empresa_id") @db.Uuid
  cpf            String    @db.VarChar(11)
  nome           String    @db.VarChar(255)
  dataNascimento DateTime  @map("data_nascimento") @db.Date
  cargo          String    @db.VarChar(255)
  dataAdmissao   DateTime  @map("data_admissao") @db.Date
  dataDemissao   DateTime? @map("data_demissao") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  empresa   Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  asos      Aso[]
  acidentes Acidente[]
  eventos   EventoESocial[]

  @@unique([empresaId, cpf])
  @@index([empresaId])
  @@map("colaboradores")
}

// ---------------------------------------------------------------------------
// Módulo 3: ASO, Risco e Mensageria eSocial.
// ---------------------------------------------------------------------------

enum TipoExame {
  ADMISSIONAL
  PERIODICO
  RETORNO_TRABALHO
  MUDANCA_RISCO
  DEMISSIONAL

  @@map("tipo_exame")
}

enum ResultadoAso {
  APTO
  INAPTO
  APTO_COM_RESTRICOES

  @@map("resultado_aso")
}

/// Atestado de Saúde Ocupacional — composição com Colaborador (não existe sem ele).
model Aso {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  colaboradorId String       @map("colaborador_id") @db.Uuid
  tipoExame     TipoExame    @map("tipo_exame")
  dataExame     DateTime     @map("data_exame") @db.Date
  resultado     ResultadoAso
  medico        String       @db.VarChar(255)
  crm           String       @db.VarChar(20)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  colaborador Colaborador     @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  eventos     EventoESocial[]

  @@index([colaboradorId])
  @@map("asos")
}

enum TipoRisco {
  FISICO
  QUIMICO
  BIOLOGICO
  ERGONOMICO
  ACIDENTE

  @@map("tipo_risco")
}

/// Risco ocupacional catalogado no PGR — composição com Empresa (avaliado no ambiente dela).
model Risco {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId     String    @map("empresa_id") @db.Uuid
  descricao     String    @db.VarChar(500)
  tipo          TipoRisco
  severidade    Int
  probabilidade Int
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  empresa Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  eventos EventoESocial[]

  @@index([empresaId])
  @@map("riscos")
}

// ---------------------------------------------------------------------------
// Módulo 4: Acidente de trabalho (origem do evento S-2210 — CAT).
// ---------------------------------------------------------------------------

/// Natureza do acidente conforme o campo `tpAcid` do leiaute.
enum TipoAcidente {
  TIPICO
  DOENCA
  TRAJETO

  @@map("tipo_acidente")
}

/// Momento da comunicação conforme o campo `tpCat`.
enum TipoCat {
  INICIAL
  REABERTURA
  COMUNICACAO_OBITO

  @@map("tipo_cat")
}

enum ParteAtingida {
  CABECA
  OLHOS
  MAO
  BRACO
  TRONCO
  PERNA
  PE
  MULTIPLAS

  @@map("parte_atingida")
}

enum AgenteCausador {
  MAQUINA
  FERRAMENTA
  QUEDA
  VEICULO
  SUBSTANCIA_QUIMICA
  ELETRICIDADE
  OUTRO

  @@map("agente_causador")
}

enum TipoLesao {
  CORTE
  FRATURA
  QUEIMADURA
  CONTUSAO
  ENTORSE
  INTOXICACAO
  OUTRA

  @@map("tipo_lesao")
}

/// Acidente de trabalho — composição com Colaborador; origem do evento S-2210.
model Acidente {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  colaboradorId         String         @map("colaborador_id") @db.Uuid
  dataAcidente          DateTime       @map("data_acidente") @db.Date
  /// Hora do acidente no formato HHMM exigido pelo leiaute.
  horaAcidente          String         @map("hora_acidente") @db.VarChar(4)
  /// Horas trabalhadas antes do acidente, formato HHMM.
  horasTrabalhadasAntes String         @map("horas_trabalhadas_antes") @db.VarChar(4)
  tipoAcidente          TipoAcidente   @map("tipo_acidente")
  tipoCat               TipoCat        @default(INICIAL) @map("tipo_cat")
  obito                 Boolean        @default(false)
  dataObito             DateTime?      @map("data_obito") @db.Date
  comunicadoPolicia     Boolean        @default(false) @map("comunicado_policia")
  localAcidente         String         @map("local_acidente") @db.VarChar(255)
  parteAtingida         ParteAtingida  @map("parte_atingida")
  agenteCausador        AgenteCausador @map("agente_causador")
  tipoLesao             TipoLesao      @map("tipo_lesao")
  descricao             String
  cid                   String?        @db.VarChar(10)
  dataAtendimento       DateTime       @map("data_atendimento") @db.Date
  horaAtendimento       String         @map("hora_atendimento") @db.VarChar(4)
  houveInternacao       Boolean        @default(false) @map("houve_internacao")
  houveAfastamento      Boolean        @default(false) @map("houve_afastamento")
  duracaoTratamentoDias Int            @default(0) @map("duracao_tratamento_dias")
  medico                String         @db.VarChar(255)
  crm                   String         @db.VarChar(20)
  ufCrm                 String         @map("uf_crm") @db.VarChar(2)
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  colaborador Colaborador     @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  eventos     EventoESocial[]

  @@index([colaboradorId])
  @@map("acidentes")
}

enum TipoEventoESocial {
  S_2210
  S_2220
  S_2240

  @@map("tipo_evento_esocial")
}

enum StatusEventoESocial {
  PENDENTE
  ENVIADO
  ACEITO
  REJEITADO

  @@map("status_evento_esocial")
}

/// Ambiente de destino conforme o campo `tpAmb` do leiaute eSocial.
enum AmbienteESocial {
  PRODUCAO
  PRODUCAO_RESTRITA

  @@map("ambiente_esocial")
}

/// Mensagem XML enviada ao eSocial. Guarda apenas estado — não monta nem envia (SRP).
model EventoESocial {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId     String              @map("empresa_id") @db.Uuid
  colaboradorId String?             @map("colaborador_id") @db.Uuid
  asoId         String?             @map("aso_id") @db.Uuid
  riscoId       String?             @map("risco_id") @db.Uuid
  acidenteId    String?             @map("acidente_id") @db.Uuid
  tipoEvento    TipoEventoESocial   @map("tipo_evento")
  payloadXml    String              @map("payload_xml")
  status        StatusEventoESocial @default(PENDENTE)
  ambiente      AmbienteESocial
  protocolo     String?             @db.VarChar(60)
  mensagemErro  String?             @map("mensagem_erro")
  dataEnvio     DateTime?           @map("data_envio") @db.Timestamptz(6)
  tentativas    Int                 @default(0)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  empresa     Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  colaborador Colaborador? @relation(fields: [colaboradorId], references: [id], onDelete: SetNull)
  aso         Aso?         @relation(fields: [asoId], references: [id], onDelete: SetNull)
  risco       Risco?       @relation(fields: [riscoId], references: [id], onDelete: SetNull)
  acidente    Acidente?    @relation(fields: [acidenteId], references: [id], onDelete: SetNull)

  @@index([empresaId])
  @@index([empresaId, status])
  @@index([asoId])
  @@index([riscoId])
  @@index([acidenteId])
  @@map("eventos_esocial")
}
